# Python
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# Generated at runtime — not source
backend/generated_scripts/
backend/profiles/

# Node
/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# Run history is transient execution logs, not something to version
data/projects/*/runs/

# Save Files/Get File/Upload File nodes' working directory — files downloaded/
# generated at run time, not source (see backend/app/config.py::temp_files_dir)
data/projects/*/temp_files/

# Secrets — credentials/backup connection strings are stored in plain JSON by
# design (see the code comments on Credential.value/BackupConfig.connectionString),
# so they must never be committed
data/projects/*/credentials.json
data/backup_config.json
data/projects/*/backup_config.json

# Stray Chrome profile dir created at repo root by a cwd bug in an earlier version
# of `npm run server:dev` (fixed below) — real profile data lives in
# backend/profiles/ (already ignored above)
/profiles/

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.log
