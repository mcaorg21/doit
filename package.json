{
  "name": "auto-mation",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "server:dev": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8001",
    "client:dev": "npm run dev --prefix frontend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run server:dev\" \"npm run client:dev\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
